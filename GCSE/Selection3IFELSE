<!doctype html>
<html>
    <head>
        <title>Parsons Puzzle: Random Range Check</title>
        <link href="../parsons.css" rel="stylesheet" />
        <link href="../lib/prettify.css" rel="stylesheet" />
        <link href="../custom.css" rel="stylesheet" />
        <script src="../lib/prettify.js"></script>
    </head>
    <body>
        <h2>Random Score Checker</h2>
        <p>Reorder the lines to generate a random score from 0 to 100. If the score falls in the range 40 to 100, print "Passed"; otherwise, print "Failed".</p>
        
        <div id="sortableTrash" class="sortable-code"></div>
        <div id="sortable" class="sortable-code"></div>
        
        <div style="clear:both;"></div>

        <div id="feedbackContainer" class="parsons-feedback"></div>
        
        <div class="puzzle-controls">
            <a href="#" id="feedbackLink" class="btn-check">Check Solution</a>
            <a href="#" id="newInstanceLink" class="btn-reset">New Instance</a>
        </div>

        <script src="../lib/jquery.min.js"></script>
        <script src="../lib/jquery-ui.min.js"></script>
        <script src="../lib/jquery.ui.touch-punch.min.js"></script>
        <script src="../lib/underscore-min.js"></script>
        <script src="../lib/lis.js"></script>
        <script src="../parsons.js"></script>
        
        <script>
        var initial = 'import random\n' +
                    'score = random.randint(0, 100)\n' +
                    'if score in range(40, 101):\n' +
                    '    print("Passed")\n' +
                    'else:\n' +
                    '    print("Failed")\n' +
                    'if score == range(40, 101): #distractor\n';

        function displayErrors(fb) {
            var fbBox = $("#feedbackContainer");
            if(fb.errors.length > 0) {
                var errorMessage = fb.errors[0];
                if (errorMessage.toLowerCase().includes("not all lines")) {
                    errorMessage = "⚠️ Whoops! You left some lines of code back in the tray. Drag all the required lines over to the solution area.";
                }
                fbBox.removeClass("success").addClass("error").text(errorMessage);
            } else {
                fbBox.removeClass("error").addClass("success").text("🎉 Great job! Your code is correct and in the right order.");
            }
        }

        $(document).ready(function(){
            var parson = new ParsonsWidget({
                'sortableId': 'sortable',
                'trashId': 'sortableTrash',
                'max_wrong_lines': 1,
                'feedback_cb' : displayErrors
            });
            parson.init(initial);
            parson.shuffleLines();
            $("#newInstanceLink").click(function(event){
                event.preventDefault();
                $("#feedbackContainer").hide();
                parson.shuffleLines();
            });
            $("#feedbackLink").click(function(event){
                event.preventDefault();
                parson.getFeedback();
            });
        });
        </script>
    </body>
</html>
